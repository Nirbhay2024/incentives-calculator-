{
  "name": "calculator-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker:dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:schema:local": "wrangler d1 execute incentives-calculator-db --local --file=db/schema.sql",
    "db:seed:local": "wrangler d1 execute incentives-calculator-db --local --file=db/seed.sql",
    "db:schema:remote": "wrangler d1 execute incentives-calculator-db --remote --file=db/schema.sql",
    "db:seed:remote": "wrangler d1 execute incentives-calculator-db --remote --file=db/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.1",
    "wrangler": "^4.114.0"
  }
}
